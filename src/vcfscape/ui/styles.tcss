/* VCFscape TCSS Stylesheet */

Screen {
    layout: vertical;
    background: #0b0f17;
    color: #e2e8f0;
}

HeaderBar {
    dock: top;
    height: 1;
    background: #1e293b;
    color: #e2e8f0;
}

#main_container {
    height: 1fr;
    layout: horizontal;
}

VariantSplitView {
    width: 1fr;
    height: 1fr;
    layout: horizontal;
}

#split_container {
    width: 1fr;
    height: 100%;
    layout: horizontal;
}

FixedVariantTable,
#fixed_table {
    height: 100%;
    background: #0b0f17;
    scrollbar-size-vertical: 0;
    overflow-y: hidden;
}

#table_divider {
    width: 1;
    min-width: 1;
    max-width: 1;
    height: 100%;
    color: #334155;
    background: #0b0f17;
}

SampleMatrixTable,
#sample_table {
    width: 1fr;
    height: 100%;
    background: #0b0f17;
}

SidebarPanel {
    width: 34;
    min-width: 28;
    max-width: 40;
    height: 1fr;
    background: #111827;
    border-left: vkey #1e293b;
    overflow-y: auto;
}

SidebarPanel > CohortListWidget {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

SidebarPanel > VariantSummary {
    height: auto;
    padding: 0 1;
    border-top: solid #1e293b;
    margin-bottom: 1;
}

SidebarPanel > CellInspector {
    height: auto;
    padding: 0 1;
    border-top: solid #1e293b;
}

CohortStatsPane {
    dock: bottom;
    background: #0d131f;
    border-top: solid #1e293b;
}

FooterBar {
    dock: bottom;
    height: 2;
    background: #090d14;
    color: #94a3b8;
}

/* Light Theme overrides */
Screen.theme-light {
    background: #f8fafc;
    color: #0f172a;
}

Screen.theme-light HeaderBar {
    background: #e2e8f0;
    color: #0f172a;
}

Screen.theme-light FixedVariantTable,
Screen.theme-light SampleMatrixTable {
    background: #ffffff;
}

Screen.theme-light SidebarPanel {
    background: #f1f5f9;
    border-left: vkey #cbd5e1;
}

Screen.theme-light SidebarPanel > VariantSummary,
Screen.theme-light SidebarPanel > CellInspector {
    border-top: solid #cbd5e1;
}

Screen.theme-light CohortStatsPane {
    background: #f8fafc;
    border-top: solid #cbd5e1;
}

Screen.theme-light FooterBar {
    background: #e2e8f0;
    color: #334155;
}
